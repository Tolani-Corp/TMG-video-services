{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tmg-video-runtime-acceptance",
  "main": "../scripts/production-runtime-acceptance-worker.mjs",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "TMG_ACCEPTANCE_TENANT": "prod_acceptance_fixture_v1",
    "TMG_ACCEPTANCE_OBJECT_PREFIX": "prod_acceptance_fixture_v1",
    "TMG_ACCEPTANCE_PROVIDER_ID": "fixture",
    "TMG_ACCEPTANCE_MODE": "fixture_only"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCEPTANCE_LEDGER",
        "class_name": "TenantUsageLedger",
        "script_name": "tmg-video-services-production"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
