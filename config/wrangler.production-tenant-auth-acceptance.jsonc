{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tmg-video-tenant-auth-acceptance",
  "main": "../scripts/production-tenant-auth-acceptance-worker.mjs",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "TMG_AUTH_MODE": "production_acceptance_only",
    "TMG_AUTH_OBJECT_PREFIX": "prod_acceptance_auth"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCEPTANCE_LEDGER",
        "class_name": "TenantUsageLedger",
        "script_name": "tmg-video-services-production"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
