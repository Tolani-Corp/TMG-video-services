{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tolani.internal/schemas/tmg-production-release-manifest-v1.json",
  "title": "TMG Production Release Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "targetEnvironment",
    "candidateMainSha",
    "workerName",
    "candidateWorkerVersionId",
    "lastKnownGoodWorkerVersionId",
    "capabilityId",
    "maxStage",
    "tenantCohortId",
    "normalTrafficPercentage",
    "frozenInfrastructureFingerprintSha256",
    "releaseAuthorityPolicySha256",
    "providerId",
    "providerAuthority",
    "billingMode",
    "publicAuthority",
    "storageMigrationAllowed",
    "createdByWorkflowRunId"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "targetEnvironment": { "const": "production" },
    "candidateMainSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workerName": { "const": "tmg-video-services-production" },
    "candidateWorkerVersionId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "lastKnownGoodWorkerVersionId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "capabilityId": { "const": "tenant_authenticated_vector_search_canary_v1" },
    "maxStage": { "const": "S1" },
    "tenantCohortId": { "const": "production_canary_v1" },
    "normalTrafficPercentage": { "const": 0 },
    "frozenInfrastructureFingerprintSha256": { "const": "feb4e3cc93d57c8390a02abece1bdf3a04e905128012480197bd23068ff4f00c" },
    "releaseAuthorityPolicySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "providerId": { "const": "fixture" },
    "providerAuthority": { "const": "fixture" },
    "billingMode": { "const": "non_billable" },
    "publicAuthority": { "const": false },
    "storageMigrationAllowed": { "const": false },
    "createdByWorkflowRunId": { "type": "string", "pattern": "^[0-9]+$" }
  }
}
