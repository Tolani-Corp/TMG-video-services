{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tolani-media-group-site",
  "main": "src/site.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/status.json"]
  },
  "services": [
    {
      "binding": "TMG_BACKEND",
      "service": "tmg-video-services-production"
    }
  ],
  "routes": [
    {
      "pattern": "tolanimediagroup.com",
      "custom_domain": true
    },
    {
      "pattern": "www.tolanimediagroup.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
