{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tolani-media-group-site",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "assets": {
    "directory": "./site"
  },
  "routes": [
    {
      "pattern": "tolanimediagroup.com",
      "custom_domain": true
    },
    {
      "pattern": "www.tolanimediagroup.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
