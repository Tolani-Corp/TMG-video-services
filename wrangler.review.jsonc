{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tmg-work-review",
  "main": "src/work-review-entry.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "r2_buckets": [
    {
      "binding": "WORK_REQUESTS",
      "bucket_name": "tmg-work-requests-prod"
    },
    {
      "binding": "DERIVATIVES",
      "bucket_name": "tmg-work-derivatives-prod"
    },
    {
      "binding": "PUBLISHED_MEDIA",
      "bucket_name": "tmg-published-media-prod"
    }
  ],
  "workflows": [
    {
      "name": "tmg-work-request-processing-prod",
      "binding": "WORK_REQUEST_PROCESSOR",
      "class_name": "WorkRequestProcessingWorkflow"
    },
    {
      "name": "tmg-processor-chain-v1-1-prod",
      "binding": "PROCESSOR_CHAIN",
      "class_name": "ProcessorChainWorkflow"
    }
  ],
  "containers": [
    {
      "class_name": "MediaExecutionContainer",
      "image": "./containers/media-executor/Dockerfile",
      "max_instances": 2,
      "instance_type": "standard-1",
      "rollout_step_percentage": 100,
      "constraints": {
        "regions": ["ENAM"]
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MEDIA_EXECUTOR",
        "class_name": "MediaExecutionContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "processor-chain-v1-1",
      "new_sqlite_classes": ["MediaExecutionContainer"]
    }
  ],
  "vars": {
    "TMG_REVIEW_ALLOWED_EMAIL_DOMAINS": "",
    "TMG_PUBLICATION_EXECUTION_ENABLED": "false",
    "TMG_EXTERNAL_PROVIDER_EGRESS_ENABLED": "false",
    "TMG_PROVIDER_ENDPOINT_ALLOWLIST": ""
  },
  "routes": [
    {
      "pattern": "review.tolanimediagroup.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
