{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tmg-video-services",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./ui",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/v1/*", "/mcp*"]
  },
  "exports": {
    "TenantUsageLedger": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ProductionRequestCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "TMG_PUBLIC_API_ENABLED": "false",
    "TMG_MCP_ENABLED": "false",
    "TMG_PRODUCTION_REQUEST_API_ENABLED": "false",
    "TMG_MARKETING_DISCOVERY_ENABLED": "false",
    "TMG_MARKETING_VIDEO_GENERATION_ENABLED": "false",
    "TMG_MARKETING_VIDEO_PROVIDER_ID": "pruna/p-video",
    "TMG_MARKETING_VIDEO_PROVIDER_ACCEPTANCE_STATE": "unverified",
    "TMG_INGEST_WORKFLOW_ENABLED": "false",
    "TMG_INGESTION_MODE": "fixture_only",
    "TMG_POLICY_VERSION": "2026-08-20.v3",
    "TMG_EMBEDDING_DIMENSIONS": "512",
    "TMG_EMBEDDING_PROVIDER_ID": "fixture",
    "TMG_EXTERNAL_PROVIDER_EGRESS_ENABLED": "false",
    "TMG_PROVIDER_ACCEPTANCE_STATE": "unverified",
    "TMG_TENANT_USAGE_LEDGER_ENABLED": "false"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TENANT_USAGE_LEDGER",
        "class_name": "TenantUsageLedger"
      },
      {
        "name": "PRODUCTION_REQUESTS",
        "class_name": "ProductionRequestCoordinator"
      }
    ]
  },
  "vectorize": [
    {
      "binding": "VIDEO_INDEX",
      "index_name": "tmg-video-segments-512-dev"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "tmg-video-assets-dev"
    }
  ],
  "workflows": [
    {
      "name": "tmg-video-ingestion-dev",
      "binding": "INGEST_WORKFLOW",
      "class_name": "IngestionWorkflow"
    },
    {
      "name": "tmg-video-revocation-dev",
      "binding": "REVOKE_WORKFLOW",
      "class_name": "RevocationWorkflow"
    },
    {
      "name": "tmg-video-production-dev",
      "binding": "PRODUCTION_WORKFLOW",
      "class_name": "ProductionWorkflow"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "production": {
      "name": "tmg-video-services-production",
      "compatibility_date": "2026-08-20",
      "workers_dev": false,
      "exports": {
        "TenantUsageLedger": {
          "type": "durable-object",
          "storage": "sqlite"
        }
      },
      "vars": {
        "TMG_PUBLIC_API_ENABLED": "false",
        "TMG_MCP_ENABLED": "false",
        "TMG_INGEST_WORKFLOW_ENABLED": "false",
        "TMG_INGESTION_MODE": "fixture_only",
        "TMG_POLICY_VERSION": "2026-08-20.v3",
        "TMG_EMBEDDING_DIMENSIONS": "512",
        "TMG_EMBEDDING_PROVIDER_ID": "fixture",
        "TMG_EXTERNAL_PROVIDER_EGRESS_ENABLED": "false",
        "TMG_PROVIDER_ACCEPTANCE_STATE": "unverified",
        "TMG_TENANT_USAGE_LEDGER_ENABLED": "false"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "TENANT_USAGE_LEDGER",
            "class_name": "TenantUsageLedger"
          }
        ]
      },
      "vectorize": [
        {
          "binding": "VIDEO_INDEX",
          "index_name": "tmg-video-segments-512-prod"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "tmg-video-assets-prod"
        }
      ],
      "workflows": [
        {
          "name": "tmg-video-ingestion-prod",
          "binding": "INGEST_WORKFLOW",
          "class_name": "IngestionWorkflow"
        },
        {
          "name": "tmg-video-revocation-prod",
          "binding": "REVOKE_WORKFLOW",
          "class_name": "RevocationWorkflow"
        }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      }
    }
  }
}
