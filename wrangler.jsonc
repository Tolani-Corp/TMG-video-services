{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tmg-video-services",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "TMG_PUBLIC_API_ENABLED": "false",
    "TMG_MCP_ENABLED": "false",
    "TMG_INGEST_WORKFLOW_ENABLED": "false",
    "TMG_INGESTION_MODE": "fixture_only",
    "TMG_POLICY_VERSION": "2026-08-20.v2",
    "TMG_EMBEDDING_DIMENSIONS": "512"
  },
  "vectorize": [
    {
      "binding": "VIDEO_INDEX",
      "index_name": "tmg-video-segments-512-dev"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "tmg-video-assets-dev"
    }
  ],
  "workflows": [
    {
      "name": "tmg-video-ingestion-dev",
      "binding": "INGEST_WORKFLOW",
      "class_name": "IngestionWorkflow"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
