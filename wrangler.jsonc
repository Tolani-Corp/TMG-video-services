{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tmg-video-services",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./ui",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/v1/*", "/mcp*", "/internal/*"]
  },
  "exports": {
    "TenantUsageLedger": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "TMG_PUBLIC_API_ENABLED": "false",
    "TMG_MCP_ENABLED": "false",
    "TMG_INGEST_WORKFLOW_ENABLED": "false",
    "TMG_INGESTION_MODE": "fixture_only",
    "TMG_POLICY_VERSION": "2026-08-20.v3",
    "TMG_EMBEDDING_DIMENSIONS": "512",
    "TMG_EMBEDDING_PROVIDER_ID": "fixture",
    "TMG_EXTERNAL_PROVIDER_EGRESS_ENABLED": "false",
    "TMG_PROVIDER_ACCEPTANCE_STATE": "unverified",
    "TMG_TENANT_USAGE_LEDGER_ENABLED": "false",
    "TMG_INTAKE_ENABLED": "false",
    "TMG_CONTROL_DB_BINDING_STATE": "unprovisioned",
    "TMG_CONSOLE_HOST": "console.tolanimediagroup.com",
    "TOLANI_RUNTIME_ENV": "development",
    "TOLANI_INTERNAL_ACCESS_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "tmg-video-control-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TENANT_USAGE_LEDGER",
        "class_name": "TenantUsageLedger"
      }
    ]
  },
  "vectorize": [
    {
      "binding": "VIDEO_INDEX",
      "index_name": "tmg-video-segments-512-dev"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "tmg-video-assets-dev"
    }
  ],
  "workflows": [
    {
      "name": "tmg-video-ingestion-dev",
      "binding": "INGEST_WORKFLOW",
      "class_name": "IngestionWorkflow"
    },
    {
      "name": "tmg-video-revocation-dev",
      "binding": "REVOKE_WORKFLOW",
      "class_name": "RevocationWorkflow"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "production": {
      "name": "tmg-video-services-production",
      "workers_dev": false,
      "vars": {
        "TMG_PUBLIC_API_ENABLED": "false",
        "TMG_MCP_ENABLED": "false",
        "TMG_INGEST_WORKFLOW_ENABLED": "false",
        "TMG_INGESTION_MODE": "fixture_only",
        "TMG_POLICY_VERSION": "2026-08-20.v3",
        "TMG_EMBEDDING_DIMENSIONS": "512",
        "TMG_EMBEDDING_PROVIDER_ID": "fixture",
        "TMG_EXTERNAL_PROVIDER_EGRESS_ENABLED": "false",
        "TMG_PROVIDER_ACCEPTANCE_STATE": "unverified",
        "TMG_TENANT_USAGE_LEDGER_ENABLED": "false",
        "TMG_INTAKE_ENABLED": "false",
        "TMG_CONTROL_DB_BINDING_STATE": "unprovisioned",
        "TMG_CONSOLE_HOST": "console.tolanimediagroup.com",
        "TOLANI_RUNTIME_ENV": "production",
        "TOLANI_INTERNAL_ACCESS_ENABLED": "false"
      },
      "d1_databases": [
        {
          "binding": "CONTROL_DB",
          "database_name": "tmg-video-control-prod",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "TENANT_USAGE_LEDGER",
            "class_name": "TenantUsageLedger"
          }
        ]
      },
      "vectorize": [
        {
          "binding": "VIDEO_INDEX",
          "index_name": "tmg-video-segments-512-prod"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "tmg-video-assets-prod"
        }
      ],
      "workflows": [
        {
          "name": "tmg-video-ingestion-prod",
          "binding": "INGEST_WORKFLOW",
          "class_name": "IngestionWorkflow"
        },
        {
          "name": "tmg-video-revocation-prod",
          "binding": "REVOKE_WORKFLOW",
          "class_name": "RevocationWorkflow"
        }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      }
    }
  }
}
